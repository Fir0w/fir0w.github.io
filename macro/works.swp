Option Explicit

Const CUT_LIST_PRPS_TRANSFER As Long = swCutListTransferOptions_e.swCutListTransferOptions_CutListProperties
Const OUT_DIR As String = ""


Dim swApp As SldWorks.SldWorks

Sub Main()

    Set swApp = Application.SldWorks
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = swApp.ActiveDoc

    If swModel Is Nothing Then
        MsgBox "No active document open.", vbExclamation
        Exit Sub
    End If

    If swModel.GetType <> swDocPART Then
        MsgBox "This macro only works on part documents.", vbExclamation
        Exit Sub
    End If

    ' 1. Rename Cut List Items
    Call RenameCutListItemsWithPrompt(swModel)

    ' 2. Insert Cut List Name Property "Cat. No."
    Call InsertCutListNameProperty(swModel)

    ' 3. Rename Bodies By Cut List Name
    Call RenameBodiesByCutListName(swModel)

    ' 4. Run test.swp functionality (export bodies as separate parts, transfer QTY)
    Call ExportBodiesAndTransferQty(swModel)

End Sub

Sub RenameCutListItemsWithPrompt(swModel As SldWorks.ModelDoc2)
    Dim swApp As SldWorks.SldWorks
    Dim swFeat As SldWorks.Feature
    Dim swSubFeat As SldWorks.Feature
    Dim swBodyFolder As SldWorks.BodyFolder
    Dim prefix As String
    Dim middleDigits As String
    Dim baseName As String
    Dim cutListIndex As Integer
    Dim newName As String
    Dim bodies As Variant

    Set swApp = Application.SldWorks
    Set swModel = swApp.ActiveDoc

    If swModel Is Nothing Then
        MsgBox "No active document open.", vbExclamation
        Exit Sub
    End If

    If swModel.GetType <> swDocPART Then
        MsgBox "This macro only works on part documents.", vbExclamation
        Exit Sub
    End If

    ' Ask for input
    prefix = InputBox("Enter the 2-letter prefix (e.g., 'ce'):", "Cut List Rename Prefix")
    If Len(prefix) <> 2 Then
        MsgBox "Prefix must be 2 characters long.", vbExclamation
        Exit Sub
    End If

    middleDigits = InputBox("Enter the numeric middle part (e.g., '001.00'):", "Cut List Rename Middle")
    If middleDigits = "" Then
        MsgBox "Middle part cannot be empty.", vbExclamation
        Exit Sub
    End If

    baseName = prefix & "." & middleDigits & "."
    cutListIndex = 1

    ' Rebuild to update cut list
    swModel.ForceRebuild3 False

    ' Start renaming valid Cut List Folders
    Set swFeat = swModel.FirstFeature
    Do While Not swFeat Is Nothing
        If swFeat.GetTypeName2 = "SolidBodyFolder" Then
            Set swSubFeat = swFeat.GetFirstSubFeature
            Do While Not swSubFeat Is Nothing
                If swSubFeat.GetTypeName2 = "CutListFolder" Then
                    Set swBodyFolder = swSubFeat.GetSpecificFeature2
                    If Not swBodyFolder Is Nothing Then
                        bodies = swBodyFolder.GetBodies
                        If Not IsEmpty(bodies) Then
                            newName = baseName & Format(cutListIndex, "00")
                            swSubFeat.Name = newName
                            cutListIndex = cutListIndex + 1
                        End If
                    End If
                End If
                Set swSubFeat = swSubFeat.GetNextSubFeature
            Loop
        End If
        Set swFeat = swFeat.GetNextFeature
    Loop

    If cutListIndex = 1 Then
        MsgBox "No non-empty Cut List items found.", vbExclamation
    Else
        MsgBox "Renamed " & (cutListIndex - 1) & " Cut List items to format: " & baseName & "xx", vbInformation
    End If
End Sub



Sub InsertCutListNameProperty(swModel As SldWorks.ModelDoc2)
    Dim swFeat As SldWorks.Feature
    Dim swSubFeat As SldWorks.Feature
    Dim swCustPropMgr As SldWorks.CustomPropertyManager
    Dim cutListName As String
    Dim partName As String
    Dim propertyValue As String
    Dim updatedCount As Integer

    partName = swModel.GetTitle ' e.g., "Part3.SLDPRT"
    Set swFeat = swModel.FirstFeature
    updatedCount = 0

    Do While Not swFeat Is Nothing
        If swFeat.GetTypeName2 = "SolidBodyFolder" Then
            Set swSubFeat = swFeat.GetFirstSubFeature
            Do While Not swSubFeat Is Nothing
                If swSubFeat.GetTypeName2 = "CutListFolder" Then
                    cutListName = swSubFeat.Name
                    propertyValue = """SW-CutListItemName@@@" & cutListName & "@" & partName & """"
                    swSubFeat.Select2 False, 0
                    swModel.EditRebuild3
                    Set swCustPropMgr = swSubFeat.CustomPropertyManager
                    swCustPropMgr.Add3 "Cat. No.", swCustomInfoText, propertyValue, swCustomPropertyDeleteAndAdd
                    updatedCount = updatedCount + 1
                End If
                Set swSubFeat = swSubFeat.GetNextSubFeature
            Loop
        End If
        Set swFeat = swFeat.GetNextFeature
    Loop

    MsgBox "Updated " & updatedCount & " cut list folders with 'Cat. No.' property.", vbInformation
End Sub

Sub RenameBodiesByCutListName(swModel As SldWorks.ModelDoc2)
    Dim swFeat As SldWorks.Feature
    Dim swCutListFolder As SldWorks.BodyFolder
    Dim swBody As SldWorks.Body2
    Dim bodyArr As Variant
    Dim folderName As String
    Dim countRenamed As Integer

    Set swFeat = swModel.FirstFeature
    countRenamed = 0

    Do While Not swFeat Is Nothing
        If swFeat.GetTypeName2 = "CutListFolder" Then
            folderName = swFeat.Name
            Set swCutListFolder = swFeat.GetSpecificFeature2
            If Not swCutListFolder Is Nothing Then
                bodyArr = swCutListFolder.GetBodies
                If Not IsEmpty(bodyArr) Then
                    Set swBody = bodyArr(0)
                    If Not swBody Is Nothing Then
                        swBody.Name = folderName
                        countRenamed = countRenamed + 1
                    End If
                End If
            End If
        End If
        Set swFeat = swFeat.GetNextFeature
    Loop

    MsgBox countRenamed & " body(ies) renamed to match cut list folder name(s).", vbInformation
End Sub

Sub ExportBodiesAndTransferQty(swModel As SldWorks.ModelDoc2)
    Dim swPart As SldWorks.PartDoc
    Set swPart = swModel

    Dim swMainFeat As SldWorks.Feature
    Dim swSubFeat As SldWorks.Feature
    Dim swBodyFolder As SldWorks.BodyFolder
    Dim bodies As Variant
    Dim swBody As SldWorks.Body2
    Dim swNewPart As SldWorks.ModelDoc2
    Dim outFilePath As String
    Dim errs As Long, warns As Long
    Dim Path As String

    Set swMainFeat = swModel.FirstFeature
    
    
    Path = SelectPartFile()
    MsgBox "Selected save path: " & Path
    

    Do While Not swMainFeat Is Nothing
        If swMainFeat.GetTypeName2 = "SolidBodyFolder" Then
            Set swSubFeat = swMainFeat.GetFirstSubFeature
            Do While Not swSubFeat Is Nothing
                If swSubFeat.GetTypeName2 = "CutListFolder" Then
                    Set swBodyFolder = swSubFeat.GetSpecificFeature2
                    If Not swBodyFolder Is Nothing Then
                        bodies = swBodyFolder.GetBodies
                        If Not IsEmpty(bodies) Then
                            Set swBody = bodies(0) ' Only export the first body

                            If swBody.Select2(False, Nothing) Then
                                'outFilePath = GetOutFilePath(swModel, swBody, OUT_DIR)
                                outFilePath = GetOutFilePath(swModel, swBody, Path)

                                If swPart.SaveToFile3(outFilePath, swSaveAsOptions_e.swSaveAsOptions_Silent, CUT_LIST_PRPS_TRANSFER, False, "", errs, warns) Then
                                    Set swNewPart = swApp.OpenDoc6(outFilePath, swDocumentTypes_e.swDocPART, swOpenDocOptions_e.swOpenDocOptions_Silent, "", errs, warns)

                                    If Not swNewPart Is Nothing Then
                                        Dim swFeat As SldWorks.Feature
                                        Set swFeat = swNewPart.FirstFeature

                                        Do While Not swFeat Is Nothing
                                            If swFeat.GetTypeName2 = "SolidBodyFolder" Then
                                                Dim swInnerBodyFolder As SldWorks.BodyFolder
                                                Set swInnerBodyFolder = swFeat.GetSpecificFeature2
                                                swInnerBodyFolder.UpdateCutList

                                                Dim swCutListFeat As SldWorks.Feature
                                                Set swCutListFeat = swFeat.GetFirstSubFeature

                                                Do While Not swCutListFeat Is Nothing
                                                    If swCutListFeat.GetTypeName2 = "CutListFolder" Then
                                                        Dim swCutListPropMgr As SldWorks.CustomPropertyManager
                                                        Set swCutListPropMgr = swCutListFeat.CustomPropertyManager

                                                        If Not swCutListPropMgr Is Nothing Then
                                                            Dim qtyVal As String
                                                            qtyVal = GetBodyQuantityFromCutList(swModel, swBody.Name)

                                                            swCutListPropMgr.Add3 "QTY", swCustomInfoType_e.swCustomInfoNumber, qtyVal, swCustomPropertyAddOption_e.swCustomPropertyReplaceValue
                                                        End If
                                                    End If
                                                    Set swCutListFeat = swCutListFeat.GetNextSubFeature
                                                Loop
                                            End If
                                            Set swFeat = swFeat.GetNextFeature
                                        Loop

                                        swNewPart.Save3 swSaveAsOptions_e.swSaveAsOptions_Silent, errs, warns
                                        swApp.CloseDoc outFilePath
                                    Else
                                        MsgBox "Failed to open saved body part for property addition: " & outFilePath, vbExclamation
                                    End If
                                Else
                                    MsgBox "Failed to save body " & swBody.Name & " to file " & outFilePath, vbExclamation
                                End If
                            Else
                                MsgBox "Failed to select body " & swBody.Name, vbExclamation
                            End If
                        End If
                    End If
                End If
                Set swSubFeat = swSubFeat.GetNextSubFeature
            Loop
        End If
        Set swMainFeat = swMainFeat.GetNextFeature
    Loop
End Sub



Function GetBodyQuantityFromCutList(model As SldWorks.ModelDoc2, bodyName As String) As String
    Dim swFeat As SldWorks.Feature
    Set swFeat = model.FirstFeature

    Do While Not swFeat Is Nothing
        If swFeat.GetTypeName2 = "SolidBodyFolder" Then
            Dim swBodyFolder As SldWorks.BodyFolder
            Set swBodyFolder = swFeat.GetSpecificFeature2
            swBodyFolder.UpdateCutList

            Dim swCutListFeat As SldWorks.Feature
            Set swCutListFeat = swFeat.GetFirstSubFeature

            Do While Not swCutListFeat Is Nothing
                If swCutListFeat.GetTypeName2 = "CutListFolder" Then
                    Dim swCutList As SldWorks.BodyFolder
                    Set swCutList = swCutListFeat.GetSpecificFeature2

                    Dim bodies As Variant
                    bodies = swCutList.GetBodies

                    If Not IsEmpty(bodies) Then
                        Dim i As Integer
                        For i = 0 To UBound(bodies)
                            Dim swBody As SldWorks.Body2
                            Set swBody = bodies(i)

                            If swBody.Name = bodyName Then
                                Dim propMgr As SldWorks.CustomPropertyManager
                                Set propMgr = swCutListFeat.CustomPropertyManager
                                Dim val As String, resolvedVal As String
                                Call propMgr.Get2("Quantity", val, resolvedVal)
                                GetBodyQuantityFromCutList = IIf(Len(resolvedVal) > 0, resolvedVal, "1")
                                Exit Function
                            End If
                        Next
                    End If
                End If
                Set swCutListFeat = swCutListFeat.GetNextSubFeature
            Loop
        End If
        Set swFeat = swFeat.GetNextFeature
    Loop

    GetBodyQuantityFromCutList = "1"
End Function

Function GetSelectedBodies(selMgr As SldWorks.SelectionMgr) As Variant
    Dim swBodies() As SldWorks.Body2, isInit As Boolean
    Dim i As Integer
    For i = 1 To selMgr.GetSelectedObjectCount2(-1)
        Dim swBody As SldWorks.Body2
        Set swBody = GetSelectedObjectBody(selMgr, i)
       
If Not swBody Is Nothing Then
If Not isInit Then
ReDim swBodies(0)
Set swBodies(0) = swBody
isInit = True
Else
If Not Contains(swBodies, swBody) Then
ReDim Preserve swBodies(UBound(swBodies) + 1)
Set swBodies(UBound(swBodies)) = swBody
End If
End If
End If
Next
If isInit Then GetSelectedBodies = swBodies Else GetSelectedBodies = Empty
End Function

Function GetSelectedObjectBody(selMgr As SldWorks.SelectionMgr, index As Integer) As SldWorks.Body2
Dim selObj As Object
Set selObj = selMgr.GetSelectedObject6(index, -1)
If Not selObj Is Nothing Then
If TypeOf selObj Is SldWorks.Body2 Then
Set GetSelectedObjectBody = selObj
ElseIf TypeOf selObj Is SldWorks.Face2 Or TypeOf selObj Is SldWorks.Edge Or TypeOf selObj Is SldWorks.Vertex Then
Set GetSelectedObjectBody = selObj.GetBody
End If
End If
End Function

Function Contains(vArr As Variant, item As Object) As Boolean
Dim i As Integer
For i = 0 To UBound(vArr)
If vArr(i) Is item Then Contains = True: Exit Function
Next
Contains = False
End Function

Function GetOutFilePath(model As SldWorks.ModelDoc2, body As SldWorks.Body2, outDir As String) As String
If outDir = "" Then
outDir = model.GetPathName()
If outDir = "" Then Err.Raise vbError, "", "Output directory undefined. Save the original part first."
outDir = Left(outDir, InStrRev(outDir, "") - 1)
End If
If Right(outDir, 1) = "" Then outDir = Left(outDir, Len(outDir) - 1)
'GetOutFilePath = ReplaceInvalidPathSymbols(body.Name & ".sldprt")
GetOutFilePath = outDir & "\" & ReplaceInvalidPathSymbols(body.Name & ".SLDPRT")
End Function

Function ReplaceInvalidPathSymbols(Path As String) As String
Const REPLACE_SYMB As String = "_"
Dim drive As String, res As String
drive = Left(Path, 3)
res = Mid(Path, 4)
Dim invalidSymbols As Variant: invalidSymbols = Array("/", ":", "*", "?", """", "<", ">", "|")
Dim i As Integer
For i = 0 To UBound(invalidSymbols)
res = Replace(res, invalidSymbols(i), REPLACE_SYMB)
Next
ReplaceInvalidPathSymbols = drive & res
End Function

Function SelectPartFile() As String
    ' Constants for FileDialog types
    ' Const msoFileDialogOpen = 1          ' Open a file
    ' Const msoFileDialogSaveAs = 2        ' Save a file
    ' Const msoFileDialogFilePicker = 3      ' Select a file
    Const msoFileDialogFolderPicker = 4  ' Select a folder

    Dim swApp As SldWorks.SldWorks
    Set swApp = Application.SldWorks
    
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = swApp.ActiveDoc
    
    Dim xlApp As Object
    Dim xlFileDialog As Object
    Dim filePath As String
    Dim initialDir As String

    ' Default return value
    SelectPartFile = ""

    ' Try to get the active model's path for initial directory
    If Not swModel Is Nothing Then
        initialDir = swModel.GetPathName()
        initialDir = Left(initialDir, InStrRev(initialDir, "\") - 1) + "\"
    Else
        initialDir = ""
    End If

    ' Create an instance of Excel to use its FileDialog
    Set xlApp = CreateObject("Excel.Application")
    Set xlFileDialog = xlApp.FileDialog(msoFileDialogFolderPicker)

    With xlFileDialog
        .Title = "Select a Save Folder"
        .InitialFileName = initialDir
        .Filters.Clear
        '.Filters.Add "SolidWorks Part Files", "*.sldprt"
        '.Filters.Add "All Files", "*.*"
        
        If .Show <> 0 Then ' If not Cancel
            filePath = .SelectedItems(1)
            SelectPartFile = filePath
        Else
            MsgBox "Aborted"
            End
        End If
    End With

    ' Cleanup
    Set xlFileDialog = Nothing
    Set xlApp = Nothing
End Function

